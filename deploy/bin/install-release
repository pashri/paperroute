#!/bin/bash
# Installed as /usr/local/sbin/paperroute-install-release (root).
# Usage: paperroute-install-release SHA CITY
# Builds the staged release of the city's app as its owner, takes it over
# as root, switches current to it, and rolls back if the app doesn't come
# up. Once it is healthy, moves the nightly timer to the city's zone.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
umask 022

STAGE=/var/cache/paperroute-stage
R=/opt/paperroute/releases
OPT=/opt/paperroute
CURRENT=$OPT/current
LOCK=/run/paperroute-install.lock
KEEP=3
HEALTH_WAIT=90
SHA_RE='^[0-9a-f]{7,12}$'
CITY_RE='^[a-z][a-z0-9]*$'
ZONE_RE='^[A-Za-z]+(/[A-Za-z0-9_+-]+)*$'
ZONE_CONF=/etc/systemd/system/paperroute-timetable.timer.d/city-zone.conf
INCOMING=
prev=

fail() {
    printf 'install-release: %s\n' "$1" >&2
    exit 2
}

cleanup() {
    if [[ -n $INCOMING ]]; then
        rm -rf -- "$INCOMING"
    fi
}

# Checks the city and the staged tree; sets APP, TREE and OWNER.
validate() {
    local uid bad project
    [[ $CITY =~ $CITY_RE ]] \
        || fail 'the city must be lowercase letters and digits'
    APP=paperroute-$CITY
    TREE=$STAGE/$SHA
    if [[ ! -d $TREE || -L $TREE ]]; then
        fail 'the staged tree is not a real directory'
    fi
    project=$TREE/apps/$APP/pyproject.toml
    if [[ ! -f $project || -L $project || -L $TREE/apps/$APP ]]; then
        fail "the staged tree has no app $APP"
    fi
    bad=$(find "$TREE/apps" -mindepth 1 -maxdepth 1 ! -name "$APP" \
        -print -quit) || fail 'cannot read the staged tree'
    [[ -z $bad ]] || fail 'the staged tree holds another app'
    OWNER=${SUDO_USER:-$(id -un)}
    uid=$(id -u -- "$OWNER" 2>/dev/null) || fail 'unknown user'
    bad=$(find "$TREE" ! -user "$uid" -print -quit) \
        || fail 'cannot read the staged tree'
    [[ -z $bad ]] || fail "the staged tree is not owned by $OWNER"
    bad=$(find "$TREE" ! -type f ! -type d -print -quit) \
        || fail 'cannot read the staged tree'
    if [[ -n $bad ]]; then
        fail 'the staged tree may hold only regular files and directories'
    fi
    [[ $EUID -eq 0 ]] || fail 'checks passed; installing needs root'
    [[ $uid -ne 0 ]] || fail 'refusing to build the release as root'
}

# Runs the project's build backend, so never as root. The venv is
# relocatable, so its scripts still run once the tree has moved. Sets ZONE.
build() {
    runuser -u "$OWNER" -- env \
        UV_PYTHON_INSTALL_DIR="$OPT/python" UV_PYTHON_DOWNLOADS=never \
        uv venv --relocatable --project "$TREE" "$TREE/.venv" 9>&-
    runuser -u "$OWNER" -- env \
        UV_PYTHON_INSTALL_DIR="$OPT/python" UV_PYTHON_DOWNLOADS=never \
        UV_LINK_MODE=copy \
        uv sync --frozen --package "$APP" --no-default-groups \
        --no-editable --compile-bytecode --project "$TREE" 9>&-
    ZONE=$(runuser -u "$OWNER" -- \
        "$TREE/.venv/bin/paperroute-board" zone 9>&-) || ZONE=
    if [[ ! $ZONE =~ $ZONE_RE || ! -f "/usr/share/zoneinfo/$ZONE" ]]; then
        printf 'install-release: %s\n' \
            'the release names no installed time zone' >&2
        exit 1
    fi
}

# Moves the tree out of the owner's reach before making it root's.
take_over() {
    local bad
    INCOMING=$(mktemp -d "$R/.incoming.XXXXXX")
    mv -T -- "$TREE" "$INCOMING/tree"
    if [[ ! -d $INCOMING/tree || -L $INCOMING/tree ]]; then
        printf 'install-release: the staged tree changed\n' >&2
        exit 1
    fi
    printf '%s\n' "$SHA" >"$INCOMING/tree/VERSION"
    printf '%s\n' "$APP" >"$INCOMING/tree/APP"
    chown -hR root:root "$INCOMING/tree"
    chmod -R go-w,ug-s "$INCOMING/tree"
    bad=$(find "$INCOMING/tree" \( ! -user root -o ! -group root \) \
        -print -quit) || bad=unreadable
    if [[ -n $bad ]]; then
        printf 'install-release: %s %s\n' 'the release tree holds entries' \
            'not owned by root after the take-over; aborting' >&2
        exit 1
    fi
    rm -rf -- "${R:?}/$SHA"
    mv -T -- "$INCOMING/tree" "$R/$SHA"
    rm -rf -- "$INCOMING"
    INCOMING=
}

switch_to() {
    ln -sfn -- "$1" "$CURRENT.new"
    mv -T -- "$CURRENT.new" "$CURRENT"
}

healthy() {
    local deadline=$((SECONDS + HEALTH_WAIT))
    while ((SECONDS < deadline)); do
        if systemctl is-active --quiet paperroute \
            && curl -sf -o /dev/null --max-time 2 http://127.0.0.1/status
        then
            return 0
        fi
        sleep 1
    done
    return 1
}

# A release from before the console scripts cannot run under these units,
# so the app is stopped rather than switched back to it.
roll_back() {
    local stopped=
    printf 'install-release: %s did not come up; rolling back\n' "$SHA" >&2
    if [[ -n $prev && ! -x $prev/.venv/bin/paperroute-board ]]; then
        systemctl stop paperroute || true
        stopped=${prev##*/}
    elif [[ -n $prev ]]; then
        switch_to "$prev"
        systemctl restart paperroute || true
    else
        systemctl stop paperroute || true
        rm -f -- "$CURRENT"
    fi
    journalctl -u paperroute -n 50 --no-pager || true
    if [[ -n $stopped ]]; then
        printf 'install-release: %s %s %s\n' \
            "$stopped predates paperroute-board; stopped paperroute." \
            'Do not reboot.' 'Re-provision from its commit to roll back.' >&2
    fi
    exit 1
}

# Points the nightly timer at the zone; reloads only when it changed.
# Returns non-zero at the first failed step (set -e is off under `if`).
set_timer_zone() {
    local tmp
    mkdir -p -- "${ZONE_CONF%/*}" || return
    tmp=$(mktemp "$ZONE_CONF.XXXXXX") || return
    {
        printf '[Timer]\n'
        printf 'OnCalendar=\n'
        printf 'OnCalendar=*-*-* 03:30:00 %s\n' "$1"
    } >"$tmp" || return
    chmod 644 "$tmp" || return
    if cmp -s "$tmp" "$ZONE_CONF"; then
        rm -f -- "$tmp"
        return 0
    fi
    mv -f -- "$tmp" "$ZONE_CONF" || return
    systemctl daemon-reload
}

# Keeps current, prev and the newest releases, up to KEEP in all.
prune() {
    local kept=" $SHA " count=1 name prev_name=${prev##*/}
    if [[ -n $prev_name && $prev_name != "$SHA" ]]; then
        kept+="$prev_name "
        count=2
    fi
    while IFS= read -r name; do
        [[ $name =~ $SHA_RE ]] || continue
        case $kept in *" $name "*) continue ;; esac
        if ((count < KEEP)); then
            kept+="$name "
            count=$((count + 1))
        else
            rm -rf -- "${R:?}/$name"
        fi
    done < <(
        find "$R" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %f\n' \
            | sort -rn | cut -d ' ' -f 2
    )
}

[[ $# -eq 2 ]] || fail 'usage: install-release SHA CITY'
[[ $1 =~ $SHA_RE ]] || fail 'the sha must be 7 to 12 lowercase hex digits'
SHA=$1
CITY=$2
if [[ $EUID -ne 0 ]]; then
    STAGE=${PAPERROUTE_STAGE:-$STAGE}
    R=${PAPERROUTE_RELEASES:-$R}
fi
validate
exec 9>"$LOCK"
if ! flock -n 9; then
    printf 'install-release: another install is running\n' >&2
    exit 1
fi
trap cleanup EXIT

build
if [[ $(readlink -- "$CURRENT" || true) == "$R/$SHA" ]]; then
    runuser -u "$OWNER" -- rm -rf -- "$TREE" 9>&-
else
    take_over
fi
prev=$(readlink -- "$CURRENT" || true)
switch_to "$R/$SHA"

if ! systemctl restart paperroute || ! healthy; then
    roll_back
fi
if ! reason=$(set_timer_zone "$ZONE" 2>&1); then
    reason=${reason//$'\n'/; }
    printf 'install-release: %s is live, but the timer zone was not set: %s\n' \
        "$SHA" "${reason:-no reason given}" >&2
    exit 1
fi
prune
printf 'install-release: %s is live\n' "$SHA"
