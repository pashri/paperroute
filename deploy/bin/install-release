#!/bin/bash
# Installed as /usr/local/sbin/paperroute-install-release (root).
# Usage: paperroute-install-release SHA APP
# Builds the staged release of the app as its owner, takes it over as
# root, switches current to it, and rolls back if the app doesn't come up.
# Once it is healthy, moves the app's timers to the app's zone.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
umask 022

STAGE=/var/cache/paperroute-stage
R=/opt/paperroute/releases
OPT=/opt/paperroute
CURRENT=$OPT/current
LOCK=/run/paperroute-install.lock
KEEP=3
HEALTH_WAIT=90
SHA_RE='^[0-9a-f]{7,12}$'
APP_RE='^[a-z][a-z0-9]*$'
ZONE_RE='^[A-Za-z]+(/[A-Za-z0-9_+-]+)*$'
TIMER_RE='^paperroute-[a-z0-9-]+\.timer$'
NAMED_ZONE_RE='^([A-Za-z_]+/[A-Za-z0-9_+/-]+|UTC)$'
SHARE=/usr/local/share/paperroute
ETC=/etc/systemd/system
INCOMING=
CONTRACT=
TIMERS=
ZONE=
prev=

fail() {
    printf 'install-release: %s\n' "$1" >&2
    exit 2
}

cleanup() {
    if [[ -n $INCOMING ]]; then
        rm -rf -- "$INCOMING"
    fi
}

# Refuses an app other than the one provision recorded as installed; with
# no record yet, any app passes.
installed_app_ok() {
    local name=
    [[ -f $SHARE/installed-app ]] || return 0
    IFS= read -r name <"$SHARE/installed-app" || true
    [[ $name != "$APP_NAME" ]] || return 0
    fail "the device runs $name, not $APP_NAME. Run scripts/provision HOST\
 $APP_NAME first."
}

# Checks the app and the staged tree; sets APP, TREE and OWNER.
validate() {
    local uid bad project
    [[ $APP_NAME =~ $APP_RE ]] \
        || fail 'the app must be lowercase letters and digits'
    installed_app_ok
    APP=paperroute-$APP_NAME
    TREE=$STAGE/$SHA
    if [[ ! -d $TREE || -L $TREE ]]; then
        fail 'the staged tree is not a real directory'
    fi
    project=$TREE/apps/$APP/pyproject.toml
    if [[ ! -f $project || -L $project || -L $TREE/apps/$APP ]]; then
        fail "the staged tree has no app $APP"
    fi
    bad=$(find "$TREE/apps" -mindepth 1 -maxdepth 1 ! -name "$APP" \
        -print -quit) || fail 'cannot read the staged tree'
    [[ -z $bad ]] || fail 'the staged tree holds another app'
    OWNER=${SUDO_USER:-$(id -un)}
    uid=$(id -u -- "$OWNER" 2>/dev/null) || fail 'unknown user'
    bad=$(find "$TREE" ! -user "$uid" -print -quit) \
        || fail 'cannot read the staged tree'
    [[ -z $bad ]] || fail "the staged tree is not owned by $OWNER"
    bad=$(find "$TREE" ! -type f ! -type d -print -quit) \
        || fail 'cannot read the staged tree'
    if [[ -n $bad ]]; then
        fail 'the staged tree may hold only regular files and directories'
    fi
    [[ $EUID -eq 0 ]] || fail 'checks passed; installing needs root'
    [[ $uid -ne 0 ]] || fail 'refusing to build the release as root'
}

# Removes the staged tree as its owner.
remove_stage() {
    runuser -u "$OWNER" -- rm -rf -- "$TREE" 9>&-
}

# Prints the units contract a file holds; a missing file holds 0.
contract_in() {
    local value=0
    if [[ -e $1 || -L $1 ]]; then
        value=
        IFS= read -r value <"$1" || true
    fi
    [[ $value =~ ^(0|[1-9][0-9]*)$ ]] || return 1
    printf '%s\n' "$value"
}

# Refuses, and removes, a release built for other units than the ones
# provision installed. Sets CONTRACT.
contract_ok() {
    local have
    CONTRACT=$(contract_in "$TREE/deploy/CONTRACT") \
        || fail 'the release has a bad units contract'
    have=$(contract_in "$SHARE/units-contract") \
        || fail 'the device has a bad units contract'
    [[ $CONTRACT != "$have" ]] || return 0
    printf 'install-release: %s %s; %s %s. %s\n' \
        'this release needs units contract' "$CONTRACT" \
        'the device has' "$have" 'Run scripts/provision HOST APP first.' >&2
    remove_stage
    exit 1
}

# Prints the timers in provision's manifest, each name checked.
manifest_timers() {
    local name
    [[ -f $SHARE/app-timers ]] \
        || fail "$SHARE/app-timers is missing; run scripts/provision"
    while IFS= read -r name || [[ -n $name ]]; do
        [[ $name =~ $TIMER_RE ]] || fail 'the timer manifest names a bad timer'
        printf '%s\n' "$name"
    done <"$SHARE/app-timers"
}

# Runs the project's build backend, so never as root. The venv is
# relocatable, so its scripts still run once the tree has moved. Sets ZONE
# when the app has timers.
build() {
    runuser -u "$OWNER" -- env \
        UV_PYTHON_INSTALL_DIR="$OPT/python" UV_PYTHON_DOWNLOADS=never \
        uv venv --relocatable --project "$TREE" "$TREE/.venv" 9>&-
    runuser -u "$OWNER" -- env \
        UV_PYTHON_INSTALL_DIR="$OPT/python" UV_PYTHON_DOWNLOADS=never \
        UV_LINK_MODE=copy \
        uv sync --frozen --package "$APP" --no-default-groups \
        --no-editable --compile-bytecode --project "$TREE" 9>&-
    [[ -n $TIMERS ]] || return 0
    ZONE=$(runuser -u "$OWNER" -- \
        "$TREE/.venv/bin/paperroute-board" zone 9>&-) || ZONE=
    if [[ ! $ZONE =~ $ZONE_RE || ! -f "/usr/share/zoneinfo/$ZONE" ]]; then
        printf 'install-release: %s\n' \
            'the release names no installed time zone' >&2
        exit 1
    fi
}

# Prints the OnCalendar= values of an installed timer's [Timer] section,
# one per line; an empty assignment clears the ones before it.
calendar_of() {
    local line section= values= header='^\[(.*)\]$'
    local calendar='^OnCalendar=(.*)$'
    while IFS= read -r line || [[ -n $line ]]; do
        if [[ $line =~ $header ]]; then
            section=${BASH_REMATCH[1]}
        elif [[ $section == Timer && $line =~ $calendar ]]; then
            line=${BASH_REMATCH[1]}
            line=${line%"${line##*[![:space:]]}"}
            if [[ -z $line ]]; then
                values=
            else
                values+=$line$'\n'
            fi
        fi
    done <"$1" || return
    printf '%s' "$values"
}

# Refuses a manifest timer whose own calendar already names a zone.
check_calendars() {
    local timer values value
    for timer in $TIMERS; do
        values=$(calendar_of "$ETC/$timer") \
            || fail "cannot read $timer; run scripts/provision"
        while IFS= read -r value; do
            [[ -n $value && ${value##* } =~ $NAMED_ZONE_RE ]] || continue
            printf 'install-release: %s %s %s\n' "$timer" \
                'already names a time zone;' \
                "the app's timer must leave it to the device." >&2
            exit 1
        done <<<"$values"
    done
}

# Prints the first link under the tree that resolves outside it and the
# shared Python, and fails; a dangling link fails too, and so does a find
# that cannot read the whole tree.
check_links() {
    local tree=$1 top python link target list
    top=$(readlink -f -- "$tree") || return 1
    python=$(readlink -f -- "$2") || return 1
    list=$(mktemp) || return 1
    if ! find "$tree" -type l -print0 >"$list"; then
        rm -f -- "$list"
        printf '%s\n' 'find failed'
        return 1
    fi
    while IFS= read -r -d '' link; do
        target=$(readlink -f -- "$link") || target=
        [[ -e $link ]] || target=
        case $target in
            "$top" | "$top"/* | "$python"/*) ;;
            *)
                rm -f -- "$list"
                printf '%s\n' "${link#"$tree"/}"
                return 1
                ;;
        esac
    done <"$list"
    rm -f -- "$list"
}

# Moves the tree out of the owner's reach before making it root's.
take_over() {
    local bad
    INCOMING=$(mktemp -d "$R/.incoming.XXXXXX")
    mv -T -- "$TREE" "$INCOMING/tree"
    if [[ ! -d $INCOMING/tree || -L $INCOMING/tree ]]; then
        printf 'install-release: the staged tree changed\n' >&2
        exit 1
    fi
    printf '%s\n' "$SHA" >"$INCOMING/tree/VERSION"
    printf '%s\n' "$APP" >"$INCOMING/tree/APP"
    chown -hR root:root "$INCOMING/tree"
    chmod -R go-w,ug-s "$INCOMING/tree"
    bad=$(find "$INCOMING/tree" \( ! -user root -o ! -group root \) \
        -print -quit) || bad=unreadable
    if [[ -n $bad ]]; then
        printf 'install-release: %s %s\n' 'the release tree holds entries' \
            'not owned by root after the take-over; aborting' >&2
        exit 1
    fi
    if ! bad=$(check_links "$INCOMING/tree" "$OPT/python"); then
        printf 'install-release: the release links outside itself: %s\n' \
            "${bad:-unreadable}" >&2
        exit 1
    fi
    rm -rf -- "${R:?}/$SHA"
    mv -T -- "$INCOMING/tree" "$R/$SHA"
    rm -rf -- "$INCOMING"
    INCOMING=
}

switch_to() {
    ln -sfn -- "$1" "$CURRENT.new"
    mv -T -- "$CURRENT.new" "$CURRENT"
}

healthy() {
    local deadline=$((SECONDS + HEALTH_WAIT))
    while ((SECONDS < deadline)); do
        if systemctl is-active --quiet paperroute \
            && curl -sf -o /dev/null --max-time 2 http://127.0.0.1/status
        then
            return 0
        fi
        sleep 1
    done
    return 1
}

# A release from before the console scripts cannot run under these units,
# so the app is stopped rather than switched back to it.
roll_back() {
    local stopped= why= was=
    printf 'install-release: %s did not come up; rolling back\n' "$SHA" >&2
    if [[ -n $prev ]]; then
        was=$(contract_in "$prev/deploy/CONTRACT") || was=unknown
    fi
    if [[ -n $prev && ! -x $prev/.venv/bin/paperroute-board ]]; then
        systemctl stop paperroute || true
        stopped=${prev##*/}
        why="$stopped predates paperroute-board; stopped paperroute."
        why+=' Do not reboot. Re-provision from its commit to roll back.'
    elif [[ -n $prev && $was != "$CONTRACT" ]]; then
        systemctl stop paperroute || true
        why="${prev##*/} is units contract $was, not $CONTRACT;"
        why+=' stopped paperroute. Do not reboot. Fix forward and redeploy.'
    elif [[ -n $prev ]]; then
        switch_to "$prev"
        systemctl restart paperroute || true
    else
        systemctl stop paperroute || true
        rm -f -- "$CURRENT"
    fi
    journalctl -u paperroute -n 50 --no-pager || true
    if [[ -n $why ]]; then
        printf 'install-release: %s\n' "$why" >&2
    fi
    exit 1
}

# Usage: set_timer_zone TIMER ZONE
# Restates the installed timer's own calendar in the zone, in a drop-in;
# reloads when it changed or when systemd says a reload is still due, so
# a failed reload is retried. Returns non-zero at the first failed step
# (set -e is off under `if`).
set_timer_zone() {
    local timer=$1 zone=$2 conf values value tmp
    conf=$ETC/$timer.d/app-zone.conf
    values=$(calendar_of "$ETC/$timer") || return
    mkdir -p -- "${conf%/*}" || return
    tmp=$(mktemp "$conf.XXXXXX") || return
    {
        printf '[Timer]\nOnCalendar=\n'
        while IFS= read -r value; do
            [[ -z $value ]] || printf 'OnCalendar=%s %s\n' "$value" "$zone"
        done <<<"$values"
    } >"$tmp" || return
    chmod 644 "$tmp" || return
    if ! cmp -s "$tmp" "$conf"; then
        mv -f -- "$tmp" "$conf" || return
    else
        rm -f -- "$tmp"
        if [[ $(systemctl show -p NeedDaemonReload --value "$timer") == no ]]
        then
            return 0
        fi
    fi
    systemctl daemon-reload
}

# Gives every manifest timer the zone; stops at the first failure.
set_timer_zones() {
    local timer
    for timer in $TIMERS; do
        set_timer_zone "$timer" "$ZONE" || return
    done
}

# Keeps current, prev and the newest releases, up to KEEP in all.
prune() {
    local kept=" $SHA " count=1 name prev_name=${prev##*/}
    if [[ -n $prev_name && $prev_name != "$SHA" ]]; then
        kept+="$prev_name "
        count=2
    fi
    while IFS= read -r name; do
        [[ $name =~ $SHA_RE ]] || continue
        case $kept in *" $name "*) continue ;; esac
        if ((count < KEEP)); then
            kept+="$name "
            count=$((count + 1))
        else
            rm -rf -- "${R:?}/$name"
        fi
    done < <(
        find "$R" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %f\n' \
            | sort -rn | cut -d ' ' -f 2
    )
}

[[ $# -eq 2 ]] || fail 'usage: install-release SHA APP'
[[ $1 =~ $SHA_RE ]] || fail 'the sha must be 7 to 12 lowercase hex digits'
SHA=$1
APP_NAME=$2
if [[ $EUID -ne 0 ]]; then
    STAGE=${PAPERROUTE_STAGE:-$STAGE}
    R=${PAPERROUTE_RELEASES:-$R}
fi
validate
exec 9>"$LOCK"
if ! flock -n 9; then
    printf 'install-release: another install is running\n' >&2
    exit 1
fi
trap cleanup EXIT

contract_ok
TIMERS=$(manifest_timers) || exit
build
check_calendars
if [[ $(readlink -- "$CURRENT" || true) == "$R/$SHA" ]]; then
    remove_stage
else
    take_over
fi
prev=$(readlink -- "$CURRENT" || true)
switch_to "$R/$SHA"

if ! systemctl restart paperroute || ! healthy; then
    roll_back
fi
if ! reason=$(set_timer_zones 2>&1); then
    reason=${reason//$'\n'/; }
    printf 'install-release: %s is live, but the timer zone was not set: %s\n' \
        "$SHA" "${reason:-no reason given}" >&2
    exit 1
fi
if [[ -n $reason ]]; then
    printf '%s\n' "$reason" >&2
fi
prune
printf 'install-release: %s is live\n' "$SHA"
