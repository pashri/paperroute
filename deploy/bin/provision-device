#!/bin/bash
# Usage: provision-device DIR   (root, on the Pi; DIR is the copied deploy/)
# One-time device setup. Idempotent: run it again after changing any file
# under deploy/.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
umask 022

UV_VERSION=0.12.1
UV_INSTALLER_URL="https://astral.sh/uv/$UV_VERSION/install.sh"
UV_INSTALLER_SHA256=d3f5412d38c99f9d024901843bf98206f0d2c6dbe64df40d0b740e2751ca62c1
KMS_OFF='s/^dtoverlay=vc4-kms-v3d/#&/'
CONFIG=/boot/firmware/config.txt
SHARE=/usr/local/share/paperroute
PYTHON_DIR=/opt/paperroute/python
SUDOERS=/etc/sudoers.d/paperroute-deploy
PIN_DIR=/etc/paperroute
PIN_FILE=$PIN_DIR/m2a.env
SUDOERS_NEW=/etc/sudoers.d/.paperroute-deploy.new

fail() {
    printf 'provision-device: %s\n' "$1" >&2
    exit 2
}

# Comments out the KMS overlay and adds the lines under a trailing [all].
edit_config() {
    local file=$1 tmp line last
    tmp=$(mktemp "$file.XXXXXX")
    sed "$KMS_OFF" "$file" >"$tmp"
    if [[ -s $tmp && -n $(tail -c 1 "$tmp") ]]; then
        printf '\n' >>"$tmp"
    fi
    last=$(grep -E '^\[' "$tmp" | tail -n 1 || true)
    if [[ $last != '[all]' ]]; then
        printf '\n[all]\n' >>"$tmp"
    fi
    for line in gpu_mem=16 dtparam=act_led_trigger=timer dtparam=spi=on; do
        if ! awk -v want="$line" '/^\[/ { found = 0 } $0 == want { found = 1 }
            END { exit !found }' "$tmp"; then
            printf '%s\n' "$line" >>"$tmp"
        fi
    done
    if cmp -s "$tmp" "$file"; then
        rm -f -- "$tmp"
    else
        mv -f -- "$tmp" "$file"
    fi
}

# Only for paths whose parent root owns: install -d follows a symlink.
make_dir() {
    local owner=$1 mode=$2 dir=$3
    [[ ! -L $dir ]] || fail "$dir is a symlink"
    install -d -o "$owner" -g "$owner" -m "$mode" "$dir"
}

# Inside a service-owned directory, so made as the service user, not root.
make_service_dir() {
    if ! setsid -w runuser -u paperroute -- install -d -m 0750 "$1" \
        </dev/null >/dev/null 2>&1; then
        printf 'provision-device: paperroute could not create %s\n' "$1" >&2
        exit 1
    fi
}

# An empty key file the app can rewrite; an existing key is kept.
make_secrets() {
    if ! setsid -w runuser -u paperroute -- sh -c 'umask 077 && { [ -e /var/lib/paperroute/secrets ] || : >/var/lib/paperroute/secrets; }' \
        </dev/null >/dev/null 2>&1; then
        printf 'provision-device: paperroute could not create the key file\n' >&2
        exit 1
    fi
}

install_uv() {
    local tmp
    case $(uv --version 2>/dev/null || true) in
        "uv $UV_VERSION" | "uv $UV_VERSION "*) return 0 ;;
    esac
    tmp=$(mktemp)
    curl -LsSf -o "$tmp" "$UV_INSTALLER_URL"
    if ! printf '%s  %s\n' "$UV_INSTALLER_SHA256" "$tmp" | sha256sum -c -; then
        rm -f -- "$tmp"
        printf 'provision-device: uv installer sha256 mismatch\n' >&2
        exit 1
    fi
    env UV_UNMANAGED_INSTALL=/usr/local/bin sh "$tmp"
    rm -f -- "$tmp"
}

# The M2a pin moved into state.json; remove the old root-owned copy.
retire_pin() {
    [[ ! -L $PIN_DIR ]] || fail "$PIN_DIR is a symlink"
    rm -f -- "$PIN_FILE"
    rmdir -- "$PIN_DIR" 2>/dev/null || true
}

copy_deploy() {
    rm -rf -- "$SHARE/deploy.new"
    cp -R -- "$DIR" "$SHARE/deploy.new"
    chown -R root:root "$SHARE/deploy.new"
    find "$SHARE/deploy.new" -type d -exec chmod 0755 {} +
    find "$SHARE/deploy.new" -type f -exec chmod 0644 {} +
    chmod 0755 "$SHARE/deploy.new"/bin/*
    rm -rf -- "$SHARE/deploy"
    mv -T -- "$SHARE/deploy.new" "$SHARE/deploy"
}

install_sudoers() {
    install -m 0440 -o root -g root \
        "$SHARE/deploy/sudoers/paperroute-deploy" "$SUDOERS_NEW"
    if ! visudo -cf "$SUDOERS_NEW"; then
        rm -f -- "$SUDOERS_NEW"
        printf 'provision-device: sudoers check failed\n' >&2
        exit 1
    fi
    mv -T -- "$SUDOERS_NEW" "$SUDOERS"
}

[[ $# -eq 1 ]] || fail 'usage: provision-device DIR'
DIR=$1
[[ -d $DIR && ! -L $DIR ]] || fail 'DIR is not a directory'
for need in bin/install-files bin/install-release bin/install-tiles \
    bin/paperroute-led sudoers/paperroute-deploy \
    polkit/50-paperroute-power.rules polkit/51-paperroute-network.rules; do
    [[ -f $DIR/$need ]] || fail "DIR has no $need"
done
[[ -n ${SUDO_USER:-} ]] || fail 'run it through sudo'
uid=$(id -u -- "$SUDO_USER" 2>/dev/null) || fail 'unknown user'
bad=$(find "$DIR" ! -user "$uid" -print -quit) || fail 'cannot read DIR'
[[ -z $bad ]] || fail "DIR is not owned by $SUDO_USER"
bad=$(find "$DIR" ! -type f ! -type d -print -quit) || fail 'cannot read DIR'
[[ -z $bad ]] || fail 'DIR may hold only regular files and directories'
[[ $EUID -eq 0 ]] || fail 'checks passed; provisioning needs root'
[[ ! -e $PIN_FILE || -e /var/lib/paperroute/state.json ]] || fail 'deploy M4 first so state.json holds the pin'

apt-get update
apt-get install -y rsync curl sqlite3 avahi-daemon libegl1 libgl1 polkitd \
    network-manager dnsmasq-base
systemctl is-active --quiet NetworkManager || fail 'NetworkManager is not running'

timedatectl set-timezone UTC
systemctl enable systemd-time-wait-sync

if ! id paperroute >/dev/null 2>&1; then
    useradd --system --user-group --home-dir /var/lib/paperroute \
        --no-create-home --shell /usr/sbin/nologin paperroute
fi

make_dir root 0755 /opt/paperroute
make_dir root 0755 /opt/paperroute/releases
make_dir root 0755 "$PYTHON_DIR"
make_dir paperroute 0750 /var/lib/paperroute
make_service_dir /var/lib/paperroute/sources
make_service_dir /var/lib/paperroute/work
make_service_dir /var/lib/paperroute/log
make_secrets
make_dir pashri 0700 /var/cache/paperroute-stage

install_uv

env UV_PYTHON_INSTALL_DIR="$PYTHON_DIR" uv python install 3.14
if ! grep -qxF "UV_PYTHON_INSTALL_DIR=$PYTHON_DIR" /etc/environment; then
    printf 'UV_PYTHON_INSTALL_DIR=%s\n' "$PYTHON_DIR" >>/etc/environment
fi

edit_config "$CONFIG"
rpi-usb-gadget on

make_dir root 0755 "$SHARE"
copy_deploy

make_dir root 0755 /usr/local/sbin
install -m 0755 -o root -g root "$SHARE/deploy/bin/install-release" \
    /usr/local/sbin/paperroute-install-release
install -m 0755 -o root -g root "$SHARE/deploy/bin/install-files" \
    /usr/local/sbin/paperroute-install-files
install -m 0755 -o root -g root "$SHARE/deploy/bin/install-tiles" \
    /usr/local/sbin/paperroute-install-tiles
/usr/local/sbin/paperroute-install-files
retire_pin

install_sudoers
printf 'Provisioned: reboot to apply config.txt\n'
