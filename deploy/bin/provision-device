#!/bin/bash
# Usage: provision-device DIR APP   (root, on the Pi)
# DIR holds kit/, the copied deploy/, and app/, the copied deploy/ of the
# app named APP (empty when it has none). One-time device setup.
# Idempotent: run it again after changing any file under either.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
umask 022

UV_VERSION=0.12.1
UV_INSTALLER_URL="https://astral.sh/uv/$UV_VERSION/install.sh"
UV_INSTALLER_SHA256=d3f5412d38c99f9d024901843bf98206f0d2c6dbe64df40d0b740e2751ca62c1
KMS_OFF='s/^dtoverlay=vc4-kms-v3d/#&/'
CONFIG=/boot/firmware/config.txt
SHARE=/usr/local/share/paperroute
PYTHON_DIR=/opt/paperroute/python
SUDOERS=/etc/sudoers.d/paperroute-deploy
PIN_DIR=/etc/paperroute
PIN_FILE=$PIN_DIR/m2a.env
SUDOERS_NEW=/etc/sudoers.d/.paperroute-deploy.new
STATE=/var/lib/paperroute/state.json
CURRENT=/opt/paperroute/current
SBIN=/usr/local/sbin
KIT_TOOLS='install-release install-files'
TOOL_RE='^[a-z][a-z0-9-]*$'
APP_RULE_RE='^ALL=\(root\) NOPASSWD: /usr/local/sbin/paperroute-([a-z][a-z0-9-]*) ""$'
APP_RE='^[a-z][a-z0-9]*$'
CONTRACT_RE='^[1-9][0-9]*$'
TIMER_RE='^paperroute-[a-z0-9-]+\.timer$'
UNIT_RE='^paperroute-[a-z0-9-]+\.(service|timer)$'
DROP_IN_DIR_RE='^paperroute(-[a-z0-9-]+)?\.(service|timer)\.d$'
DROP_IN_RE='^[a-z0-9-]+\.conf$'
# Tests point it at a temp directory; root always uses the real one.
if [[ $EUID -ne 0 ]]; then
    SHARE=${PAPERROUTE_SHARE:-$SHARE}
fi

fail() {
    printf 'provision-device: %s\n' "$1" >&2
    exit 2
}

# Comments out the KMS overlay and adds the lines under a trailing [all].
edit_config() {
    local file=$1 tmp line last
    tmp=$(mktemp "$file.XXXXXX")
    sed "$KMS_OFF" "$file" >"$tmp"
    if [[ -s $tmp && -n $(tail -c 1 "$tmp") ]]; then
        printf '\n' >>"$tmp"
    fi
    last=$(grep -E '^\[' "$tmp" | tail -n 1 || true)
    if [[ $last != '[all]' ]]; then
        printf '\n[all]\n' >>"$tmp"
    fi
    for line in gpu_mem=16 dtparam=act_led_trigger=timer dtparam=spi=on; do
        if ! awk -v want="$line" '/^\[/ { found = 0 } $0 == want { found = 1 }
            END { exit !found }' "$tmp"; then
            printf '%s\n' "$line" >>"$tmp"
        fi
    done
    if cmp -s "$tmp" "$file"; then
        rm -f -- "$tmp"
    else
        mv -f -- "$tmp" "$file"
    fi
}

# Only for paths whose parent root owns: install -d follows a symlink.
make_dir() {
    local owner=$1 mode=$2 dir=$3
    [[ ! -L $dir ]] || fail "$dir is a symlink"
    install -d -o "$owner" -g "$(id -gn -- "$owner")" -m "$mode" "$dir"
}

# Inside a service-owned directory, so made as the service user, not root.
make_service_dir() {
    if ! setsid -w runuser -u paperroute -- install -d -m 0750 "$1" \
        </dev/null >/dev/null 2>&1; then
        printf 'provision-device: paperroute could not create %s\n' "$1" >&2
        exit 1
    fi
}

# An empty key file the app can rewrite; an existing key is kept.
make_secrets() {
    if ! setsid -w runuser -u paperroute -- sh -c 'umask 077 && { [ -e /var/lib/paperroute/secrets ] || : >/var/lib/paperroute/secrets; }' \
        </dev/null >/dev/null 2>&1; then
        printf 'provision-device: paperroute could not create the key file\n' >&2
        exit 1
    fi
}

install_uv() {
    local tmp
    case $(uv --version 2>/dev/null || true) in
        "uv $UV_VERSION" | "uv $UV_VERSION "*) return 0 ;;
    esac
    tmp=$(mktemp)
    curl -LsSf -o "$tmp" "$UV_INSTALLER_URL"
    if ! printf '%s  %s\n' "$UV_INSTALLER_SHA256" "$tmp" | sha256sum -c -; then
        rm -f -- "$tmp"
        printf 'provision-device: uv installer sha256 mismatch\n' >&2
        exit 1
    fi
    env UV_UNMANAGED_INSTALL=/usr/local/bin sh "$tmp"
    rm -f -- "$tmp"
}

# The M2a pin moved into state.json; remove the old root-owned copy.
retire_pin() {
    [[ ! -L $PIN_DIR ]] || fail "$PIN_DIR is a symlink"
    rm -f -- "$PIN_FILE"
    rmdir -- "$PIN_DIR" 2>/dev/null || true
}

# Replaces $SHARE/NAME with a root-owned copy of a staged directory.
copy_tree() {
    local src=$1 dest=$SHARE/$2
    rm -rf -- "$dest.new"
    cp -R -- "$src" "$dest.new"
    chown -R root:root "$dest.new"
    find "$dest.new" -type d -exec chmod 0755 {} +
    find "$dest.new" -type f -exec chmod 0644 {} +
    if [[ -d $dest.new/bin ]]; then
        find "$dest.new/bin" -type f -exec chmod 0755 {} +
    fi
    rm -rf -- "$dest"
    mv -T -- "$dest.new" "$dest"
}

# The kit's copy stays at $SHARE/deploy, where the screen units look.
copy_deploy() {
    copy_tree "$DIR/kit" deploy
    copy_tree "$DIR/app" app
}

# Records the kit's units contract for install-release.
write_contract() {
    local value=
    IFS= read -r value <"$SHARE/deploy/CONTRACT" || true
    [[ $value =~ $CONTRACT_RE ]] \
        || fail 'kit/CONTRACT must hold a units contract number'
    printf '%s\n' "$value" >"$SHARE/units-contract"
}

# Lists the app's timers, the only ones install-release gives a zone.
write_manifest() {
    local path name names=
    for path in "$SHARE"/app/systemd/*.timer; do
        [[ -f $path ]] || continue
        name=${path##*/}
        [[ $name =~ $TIMER_RE ]] || fail "the app's timer $name has a bad name"
        names+=$name$'\n'
    done
    printf '%s' "$names" >"$SHARE/app-timers"
}

# Fails on anything under app/systemd that is not a paperroute unit the
# kit lacks, or a drop-in for a unit the kit or the app ships.
check_app_units() {
    local dir=$DIR/app/systemd path name file
    [[ -e $dir ]] || return 0
    [[ -d $dir ]] || fail 'app/systemd is not a directory'
    for path in "$dir"/* "$dir"/.[!.]*; do
        [[ -e $path ]] || continue
        name=${path##*/}
        if [[ -f $path && $name =~ $UNIT_RE ]]; then
            [[ ! -e $DIR/kit/systemd/$name ]] \
                || fail "the app may not replace systemd/$name"
            continue
        fi
        [[ -d $path && $name =~ $DROP_IN_DIR_RE ]] \
            || fail "the app may not ship systemd/$name"
        if [[ ! -f $dir/${name%.d} && ! -f $DIR/kit/systemd/${name%.d} ]]; then
            fail "systemd/$name is for a unit nobody ships"
        fi
        for file in "$path"/* "$path"/.[!.]*; do
            [[ -e $file ]] || continue
            if [[ ! -f $file || ! ${file##*/} =~ $DROP_IN_RE \
                || ${file##*/} == app-zone.conf ]]; then
                fail "the app may not ship systemd/$name/${file##*/}"
            fi
        done
    done
}

# Prints the app recorded as installed: provision's record, else the live
# release's; empty when neither names one.
installed_app() {
    local name=
    if [[ -f $SHARE/installed-app ]]; then
        IFS= read -r name <"$SHARE/installed-app" || true
    elif [[ -f $CURRENT/APP ]]; then
        IFS= read -r name <"$CURRENT/APP" || true
        name=${name#paperroute-}
    fi
    [[ $name =~ $APP_RE ]] || name=
    printf '%s\n' "$name"
}

# Another app's settings are not this app's: stops the board, renames its
# state file aside (kept), and records the app now installed.
set_state_aside() {
    local old
    old=$(installed_app)
    if [[ -n $old && $old != "$APP_NAME" ]] && [[ -e $STATE || -L $STATE ]]
    then
        systemctl stop paperroute
        mv -T -- "$STATE" "$STATE.$old-$(date -u +%s)"
    fi
    printf '%s\n' "$APP_NAME" >"$SHARE/installed-app"
}

# Installs each tool in the app's root-owned copy as paperroute-NAME,
# removes any paperroute tool neither the kit nor the app ships, and prints
# the names it installed. A bad name or a kit tool's name installs nothing.
install_app_tools() {
    local path name keep names=
    for path in "$SHARE"/app/bin/* "$SHARE"/app/bin/.[!.]* \
        "$SHARE"/app/bin/..?*; do
        [[ -e $path || -L $path ]] || continue
        name=${path##*/}
        if [[ ! -f $path || -L $path || ! $name =~ $TOOL_RE \
            || " $KIT_TOOLS " == *" $name "* ]]; then
            printf 'provision-device: app tool %s is not allowed\n' \
                "$name" >&2
            exit 1
        fi
        names+=$name$'\n'
    done
    for name in $names; do
        path=$SHARE/app/bin/$name
        install -m 0755 -o root -g root "$path" "$SBIN/paperroute-$name" \
            || exit 1
    done
    keep=$'\n'${KIT_TOOLS// /$'\n'}$'\n'$names
    for path in "$SBIN"/paperroute-*; do
        [[ -e $path || -L $path ]] || continue
        name=${path##*/paperroute-}
        if [[ $keep != *$'\n'"$name"$'\n'* ]]; then
            rm -f -- "$path" || exit 1
        fi
    done
    printf '%s' "$names"
}

# Succeeds when a rendered line from the KIND (kit or app) sudoers file is
# blank, a "# " comment, or a rule that file may hold: the kit rule in the
# kit's, one no-argument rule for a just-installed TOOLS entry in the app's.
allowed_sudoers_line() {
    local kind=$1 line=$2 tools=$3 kit_rule=$4 rest
    [[ $line != *\\ ]] || return 1
    if [[ $line =~ ^[[:space:]]*$ || $line == '#' || $line == '# '* ]]; then
        return 0
    fi
    if [[ $kind == kit ]]; then
        [[ $line == "$kit_rule" ]]
        return
    fi
    [[ $line == "$DEPLOY_USER "* ]] || return 1
    rest=${line#"$DEPLOY_USER "}
    [[ $rest =~ $APP_RULE_RE ]] || return 1
    [[ " $KIT_TOOLS " != *" ${BASH_REMATCH[1]} "* \
        && $'\n'$tools$'\n' == *$'\n'"${BASH_REMATCH[1]}"$'\n'* ]]
}

# Writes the kit's sudoers file, then the app's, with the deploy user in
# place of the shipped default; refuses the lot if any line is not allowed.
# TOOLS are the app tools install_app_tools installed, one per line.
install_sudoers() {
    local tools=$1 kit=$SHARE/deploy/sudoers/paperroute-deploy file kind
    local line text= kit_rule
    kit_rule="$DEPLOY_USER ALL=(root) NOPASSWD:"
    kit_rule+=' /usr/local/sbin/paperroute-install-release,'
    kit_rule+=' /usr/local/sbin/paperroute-install-files ""'
    rm -f -- "$SUDOERS_NEW"
    for file in "$kit" "$SHARE"/app/sudoers/*; do
        [[ -e $file || -L $file ]] || continue
        kind=app
        [[ $file != "$kit" ]] || kind=kit
        if [[ ! -f $file || -L $file ]]; then
            printf 'provision-device: %s is not a file\n' "$file" >&2
            exit 1
        fi
        while IFS= read -r line || [[ -n $line ]]; do
            line=${line/#pashri /$DEPLOY_USER }
            if ! allowed_sudoers_line "$kind" "$line" "$tools" "$kit_rule"
            then
                printf 'provision-device: sudoers line not allowed: %s\n' \
                    "$line" >&2
                exit 1
            fi
            text+=$line$'\n'
        done <"$file"
    done
    if [[ $'\n'$text != *$'\n'"$kit_rule"$'\n'* ]]; then
        printf 'provision-device: sudoers check failed\n' >&2
        exit 1
    fi
    (umask 0337 && printf '%s' "$text" >"$SUDOERS_NEW")
    if ! visudo -cf "$SUDOERS_NEW"; then
        rm -f -- "$SUDOERS_NEW"
        printf 'provision-device: sudoers check failed\n' >&2
        exit 1
    fi
    mv -T -- "$SUDOERS_NEW" "$SUDOERS"
}

[[ $# -eq 2 ]] || fail 'usage: provision-device DIR APP'
DIR=$1
APP_NAME=$2
[[ $APP_NAME =~ $APP_RE ]] \
    || fail 'the app must be lowercase letters and digits'
[[ -d $DIR && ! -L $DIR ]] || fail 'DIR is not a directory'
for need in bin/install-files bin/install-release \
    bin/paperroute-led sudoers/paperroute-deploy \
    polkit/50-paperroute-power.rules polkit/51-paperroute-network.rules; do
    [[ -f $DIR/kit/$need ]] || fail "DIR has no kit/$need"
done
[[ -n ${SUDO_USER:-} ]] || fail 'run it through sudo'
DEPLOY_USER=$SUDO_USER
[[ $DEPLOY_USER =~ ^[a-z_][a-z0-9_-]*$ ]] \
    || fail 'the deploy user must be a plain lowercase name'
[[ $DEPLOY_USER != paperroute ]] \
    || fail 'the deploy user cannot be the service user'
uid=$(id -u -- "$DEPLOY_USER" 2>/dev/null) || fail 'unknown user'
[[ $uid -ne 0 ]] || fail 'the deploy user cannot be root'
bad=$(find "$DIR" ! -user "$uid" -print -quit) || fail 'cannot read DIR'
[[ -z $bad ]] || fail "DIR is not owned by $SUDO_USER"
bad=$(find "$DIR" ! -type f ! -type d -print -quit) || fail 'cannot read DIR'
[[ -z $bad ]] || fail 'DIR may hold only regular files and directories'
[[ -d $DIR/app ]] || fail 'DIR has no app/'
contract=
if [[ -f $DIR/kit/CONTRACT ]]; then
    IFS= read -r contract <"$DIR/kit/CONTRACT" || true
fi
[[ $contract =~ $CONTRACT_RE ]] \
    || fail 'kit/CONTRACT must hold a units contract number'
check_app_units
[[ $EUID -eq 0 ]] || fail 'checks passed; provisioning needs root'
[[ ! -e $PIN_FILE || -e /var/lib/paperroute/state.json ]] || fail 'deploy M4 first so state.json holds the pin'

apt-get update
apt-get install -y rsync curl sqlite3 avahi-daemon libegl1 libgl1 polkitd \
    fontconfig-config \
    network-manager dnsmasq-base
systemctl start NetworkManager
for _ in {1..10}; do
    systemctl is-active --quiet NetworkManager && break
    sleep 1
done
systemctl is-active --quiet NetworkManager || fail 'NetworkManager is not running'

timedatectl set-timezone UTC
systemctl enable systemd-time-wait-sync

if ! id paperroute >/dev/null 2>&1; then
    useradd --system --user-group --home-dir /var/lib/paperroute \
        --no-create-home --shell /usr/sbin/nologin paperroute
fi

make_dir root 0755 /opt/paperroute
make_dir root 0755 /opt/paperroute/releases
make_dir root 0755 "$PYTHON_DIR"
make_dir paperroute 0750 /var/lib/paperroute
make_service_dir /var/lib/paperroute/sources
make_service_dir /var/lib/paperroute/work
make_service_dir /var/lib/paperroute/log
make_secrets
make_dir "$DEPLOY_USER" 0700 /var/cache/paperroute-stage

install_uv

env UV_PYTHON_INSTALL_DIR="$PYTHON_DIR" uv python install 3.14
if ! grep -qxF "UV_PYTHON_INSTALL_DIR=$PYTHON_DIR" /etc/environment; then
    printf 'UV_PYTHON_INSTALL_DIR=%s\n' "$PYTHON_DIR" >>/etc/environment
fi

edit_config "$CONFIG"
rpi-usb-gadget on

make_dir root 0755 "$SHARE"
copy_deploy
write_contract
write_manifest
set_state_aside

make_dir root 0755 "$SBIN"
for name in $KIT_TOOLS; do
    install -m 0755 -o root -g root "$SHARE/deploy/bin/$name" \
        "$SBIN/paperroute-$name"
done
tools=$(install_app_tools) || exit
/usr/local/sbin/paperroute-install-files
retire_pin

install_sudoers "$tools"
printf 'Provisioned: reboot to apply config.txt\n'
