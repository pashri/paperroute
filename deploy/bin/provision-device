#!/bin/bash
# Usage: provision-device DIR APP   (root, on the Pi)
# DIR holds kit/, the copied deploy/, and app/, the copied deploy/ of the
# app named APP (empty when it has none). Sets up the device and adds the
# app beside any already installed; the first app becomes the active one.
# A device in the single-app layout is first moved to the per-app one.
# Idempotent: run it again after changing any file under either.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
umask 022

UV_VERSION=0.12.1
UV_INSTALLER_URL="https://astral.sh/uv/$UV_VERSION/install.sh"
UV_INSTALLER_SHA256=d3f5412d38c99f9d024901843bf98206f0d2c6dbe64df40d0b740e2751ca62c1
KMS_OFF='s/^dtoverlay=vc4-kms-v3d/#&/'
CONFIG=/boot/firmware/config.txt
SHARE=/usr/local/share/paperroute
OPT=/opt/paperroute
VAR=/var/lib/paperroute
PYTHON_DIR=/opt/paperroute/python
SUDOERS=/etc/sudoers.d/paperroute-deploy
PIN_DIR=/etc/paperroute
PIN_FILE=$PIN_DIR/m2a.env
SUDOERS_NEW=/etc/sudoers.d/.paperroute-deploy.new
SBIN=/usr/local/sbin
LOCK=/run/paperroute-install.lock
KIT_TOOLS='install-release install-files'
TOOL_RE='^[a-z][a-z0-9-]*$'
APP_RULE_RE='^ALL=\(root\) NOPASSWD: /usr/local/sbin/paperroute-([a-z][a-z0-9]*)-([a-z][a-z0-9-]*) ""$'
APP_RE='^[a-z][a-z0-9]*$'
CONTRACT_RE='^[1-9][0-9]*$'
TIMER_RE='^paperroute-[a-z0-9-]+\.timer$'
READY_RE='^paperroute-[a-z0-9-]+\.service$'
UNIT_RE='^paperroute-[a-z0-9-]+\.(service|timer)$'
DROP_IN_DIR_RE='^paperroute(-[a-z0-9-]+)?\.(service|timer)\.d$'
DROP_IN_RE='^[a-z0-9-]+\.conf$'
# Tests point it at a temp directory; root always uses the real one.
if [[ $EUID -ne 0 ]]; then
    SHARE=${PAPERROUTE_SHARE:-$SHARE}
    OPT=${PAPERROUTE_OPT:-$OPT}
    VAR=${PAPERROUTE_VAR:-$VAR}
fi

fail() {
    printf 'provision-device: %s\n' "$1" >&2
    exit 2
}

# Comments out the KMS overlay and adds the lines under a trailing [all].
edit_config() {
    local file=$1 tmp line last
    tmp=$(mktemp "$file.XXXXXX")
    sed "$KMS_OFF" "$file" >"$tmp"
    if [[ -s $tmp && -n $(tail -c 1 "$tmp") ]]; then
        printf '\n' >>"$tmp"
    fi
    last=$(grep -E '^\[' "$tmp" | tail -n 1 || true)
    if [[ $last != '[all]' ]]; then
        printf '\n[all]\n' >>"$tmp"
    fi
    for line in gpu_mem=16 dtparam=act_led_trigger=timer dtparam=spi=on; do
        if ! awk -v want="$line" '/^\[/ { found = 0 } $0 == want { found = 1 }
            END { exit !found }' "$tmp"; then
            printf '%s\n' "$line" >>"$tmp"
        fi
    done
    if cmp -s "$tmp" "$file"; then
        rm -f -- "$tmp"
    else
        mv -f -- "$tmp" "$file"
    fi
}

# Only for paths whose parent root owns: install -d follows a symlink.
make_dir() {
    local owner=$1 mode=$2 dir=$3
    [[ ! -L $dir ]] || fail "$dir is a symlink"
    install -d -o "$owner" -g "$(id -gn -- "$owner")" -m "$mode" "$dir"
}

# Makes the app's data folders as the service user, with an empty key
# file the app can rewrite (an existing key is kept), and its release
# folders as root.
make_app_dirs() {
    local home=$VAR/apps/$APP_NAME
    if ! setsid -w runuser -u paperroute -- install -d -m 0750 "$VAR/apps" \
        "$home" "$home/sources" "$home/work" "$home/log" \
        </dev/null >/dev/null 2>&1 9>&-; then
        printf 'provision-device: paperroute could not create %s\n' "$home" >&2
        exit 1
    fi
    if ! setsid -w runuser -u paperroute -- sh -c 'umask 077 && { [ -e "$1/secrets" ] || : >"$1/secrets"; }' sh "$home" \
        </dev/null >/dev/null 2>&1 9>&-; then
        printf 'provision-device: paperroute could not create the key file\n' >&2
        exit 1
    fi
    make_dir root 0755 "$OPT/apps"
    make_dir root 0755 "$OPT/apps/$APP_NAME"
    make_dir root 0755 "$OPT/apps/$APP_NAME/releases"
}

install_uv() {
    local tmp
    case $(uv --version 2>/dev/null || true) in
        "uv $UV_VERSION" | "uv $UV_VERSION "*) return 0 ;;
    esac
    tmp=$(mktemp)
    curl -LsSf -o "$tmp" "$UV_INSTALLER_URL"
    if ! printf '%s  %s\n' "$UV_INSTALLER_SHA256" "$tmp" | sha256sum -c -; then
        rm -f -- "$tmp"
        printf 'provision-device: uv installer sha256 mismatch\n' >&2
        exit 1
    fi
    env UV_UNMANAGED_INSTALL=/usr/local/bin sh "$tmp"
    rm -f -- "$tmp"
}

# The M2a pin moved into state.json; remove the old root-owned copy.
retire_pin() {
    [[ ! -L $PIN_DIR ]] || fail "$PIN_DIR is a symlink"
    rm -f -- "$PIN_FILE"
    rmdir -- "$PIN_DIR" 2>/dev/null || true
}

# Makes $SHARE/NAME.new a root-owned copy of a staged directory.
stage_copy() {
    local src=$1 dest=$SHARE/$2.new
    rm -rf -- "$dest"
    cp -R -- "$src" "$dest"
    chown -R root:root "$dest"
    find "$dest" -type d -exec chmod 0755 {} +
    find "$dest" -type f -exec chmod 0644 {} +
    if [[ -d $dest/bin ]]; then
        find "$dest/bin" -type f -exec chmod 0755 {} +
    fi
}

# Replaces $SHARE/NAME with its copy from stage_copy.
move_in() {
    rm -rf -- "${SHARE:?}/$1"
    mv -T -- "$SHARE/$1.new" "$SHARE/$1"
}

# Replaces $SHARE/NAME with a root-owned copy of a staged directory.
copy_tree() {
    stage_copy "$1" "$2"
    move_in "$2"
}

# The kit's copy stays at $SHARE/deploy, where the screen units look. The
# app's waits at $SHARE/apps/APP_NAME.new until take_app_copy has checked
# it.
copy_deploy() {
    copy_tree "$DIR/kit" deploy
    make_dir root 0755 "$SHARE/apps"
    stage_copy "$DIR/app" "apps/$APP_NAME"
}

# Records the kit's units contract for install-release.
write_contract() {
    local value=
    IFS= read -r value <"$SHARE/deploy/CONTRACT" || true
    [[ $value =~ $CONTRACT_RE ]] \
        || fail 'kit/CONTRACT must hold a units contract number'
    printf '%s\n' "$value" >"$SHARE/units-contract"
}

# Lists the app's timers, the only ones install-release gives a zone.
write_manifest() {
    local path name names= app=$SHARE/apps/$APP_NAME
    for path in "$app"/systemd/*.timer; do
        [[ -f $path ]] || continue
        name=${path##*/}
        [[ $name =~ $TIMER_RE ]] || fail "the app's timer $name has a bad name"
        names+=$name$'\n'
    done
    printf '%s' "$names" >"$app/timers"
}

# Fails on anything under app/systemd that is not a paperroute unit the
# kit lacks, or a drop-in for paperroute.service or for one of the app's
# own units.
check_app_units() {
    local dir=$DIR/app/systemd path name file
    [[ -e $dir ]] || return 0
    [[ -d $dir ]] || fail 'app/systemd is not a directory'
    for path in "$dir"/* "$dir"/.[!.]*; do
        [[ -e $path ]] || continue
        name=${path##*/}
        if [[ -f $path && $name =~ $UNIT_RE ]]; then
            [[ ! -e $DIR/kit/systemd/$name ]] \
                || fail "the app may not replace systemd/$name"
            continue
        fi
        [[ -d $path && $name =~ $DROP_IN_DIR_RE ]] \
            || fail "the app may not ship systemd/$name"
        if [[ $name != paperroute.service.d && ! -f $dir/${name%.d} ]]; then
            [[ ! -f $DIR/kit/systemd/${name%.d} ]] \
                || fail "the app may not change systemd/${name%.d}"
            fail "systemd/$name is for a unit nobody ships"
        fi
        for file in "$path"/* "$path"/.[!.]*; do
            [[ -e $file ]] || continue
            if [[ ! -f $file || ! ${file##*/} =~ $DROP_IN_RE \
                || ${file##*/} == app-zone.conf ]]; then
                fail "the app may not ship systemd/$name/${file##*/}"
            fi
        done
    done
}

# Fails unless app/ready, when present, is one line naming one of the
# app's own services.
check_ready() {
    local file=$DIR/app/ready line name= count=0
    [[ -e $file || -L $file ]] || return 0
    if [[ -f $file && ! -L $file ]]; then
        while IFS= read -r line || [[ -n $line ]]; do
            name=$line
            count=$((count + 1))
        done <"$file"
    fi
    if [[ $count -ne 1 || ! $name =~ $READY_RE \
        || ! -f $DIR/app/systemd/$name ]]; then
        fail "the app's ready file must name one of its own services"
    fi
}

# Prints the app a single-app device recorded: provision's record, else
# the live release's; empty when neither names one.
single_app_name() {
    local name=
    if [[ -f $SHARE/installed-app ]]; then
        IFS= read -r name <"$SHARE/installed-app" || true
    elif [[ -f $OPT/current/APP ]]; then
        IFS= read -r name <"$OPT/current/APP" || true
        name=${name#paperroute-}
    fi
    [[ $name =~ $APP_RE ]] || name=
    printf '%s\n' "$name"
}

# Prints the apps in $SHARE/apps, sorted, one per line.
installed_apps() {
    local path name
    for path in "$SHARE"/apps/*; do
        name=${path##*/}
        if [[ -d $path && ! -L $path && $name =~ $APP_RE ]]; then
            printf '%s\n' "$name"
        fi
    done
}

# Prints the app named in $SHARE/active-app, or nothing.
active_app() {
    local name=
    if [[ -f $SHARE/active-app ]]; then
        IFS= read -r name <"$SHARE/active-app" || true
    fi
    if [[ $name =~ $APP_RE ]]; then
        printf '%s\n' "$name"
    fi
}

# Records APP_NAME as the active app when no app is.
record_active() {
    [[ -z $(active_app) ]] || return 0
    printf '%s\n' "$APP_NAME" >"$SHARE/active-app"
}

# Prints the names of the tools in an app's root-owned copy, the folder
# given, one per line; refuses a non-file, a bad name or a kit tool's
# name.
app_tool_names() {
    local path name app=$1
    for path in "$app"/bin/* "$app"/bin/.[!.]* "$app"/bin/..?*; do
        [[ -e $path || -L $path ]] || continue
        name=${path##*/}
        if [[ ! -f $path || -L $path || ! $name =~ $TOOL_RE \
            || " $KIT_TOOLS " == *" $name "* ]]; then
            printf 'provision-device: app tool %s is not allowed\n' \
                "$name" >&2
            exit 1
        fi
        printf '%s\n' "$name"
    done
}

# Installs every installed app's tools from its root-owned copy as
# paperroute-APP-TOOL and removes any paperroute tool neither the kit nor
# an installed app ships. Every app's tools are checked before any is
# installed.
install_app_tools() {
    local app tools tool name path wanted= keep
    for app in $(installed_apps); do
        tools=$(app_tool_names "$SHARE/apps/$app") || exit 1
        for name in $tools; do
            wanted+=$app-$name$'\n'
        done
    done
    for tool in $wanted; do
        app=${tool%%-*}
        name=${tool#*-}
        path=$SHARE/apps/$app/bin/$name
        install -m 0755 -o root -g root "$path" \
            "$SBIN/paperroute-$app-$name" || exit 1
    done
    keep=$'\n'${KIT_TOOLS// /$'\n'}$'\n'$wanted
    for path in "$SBIN"/paperroute-*; do
        [[ -e $path || -L $path ]] || continue
        name=${path##*/paperroute-}
        if [[ $keep != *$'\n'"$name"$'\n'* ]]; then
            rm -f -- "$path" || exit 1
        fi
    done
}

# Succeeds when a rendered sudoers LINE is blank, a "# " comment, or a
# rule its file may hold: KIT_RULE in the kit's file; in APP's, one
# no-argument rule for one of APP's TOOLS (one per line).
allowed_sudoers_line() {
    local line=$1 kit_rule=$2 app=${3:-} tools=${4:-} rest
    [[ $line != *\\ ]] || return 1
    if [[ $line =~ ^[[:space:]]*$ || $line == '#' || $line == '# '* ]]; then
        return 0
    fi
    if [[ -z $app ]]; then
        [[ $line == "$kit_rule" ]]
        return
    fi
    [[ $line == "$DEPLOY_USER "* ]] || return 1
    rest=${line#"$DEPLOY_USER "}
    [[ $rest =~ $APP_RULE_RE ]] || return 1
    [[ ${BASH_REMATCH[1]} == "$app" \
        && $'\n'$tools$'\n' == *$'\n'"${BASH_REMATCH[2]}"$'\n'* ]]
}

# Prints one sudoers FILE with the deploy user in place of the shipped
# default; exits at a line allowed_sudoers_line refuses for KIT_RULE and,
# for an app's file, APP and TOOLS.
sudoers_file() {
    local file=$1 kit_rule=$2 app=${3:-} tools=${4:-} line
    if [[ ! -f $file || -L $file ]]; then
        printf 'provision-device: %s is not a file\n' "$file" >&2
        exit 1
    fi
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line/#pashri /$DEPLOY_USER }
        if ! allowed_sudoers_line "$line" "$kit_rule" "$app" "$tools"; then
            if [[ $line == *[[:cntrl:]]* ]]; then
                line=$(printf '%q' "$line")
            fi
            printf 'provision-device: sudoers line not allowed: %s\n' \
                "$line" >&2
            exit 1
        fi
        printf '%s\n' "$line"
    done <"$file"
}

# Prints the kit's sudoers file, then each installed app's, refusing the
# lot if any line or app tool is not allowed. While APP_COPY holds the
# staged copy of APP_NAME, that copy stands in for APP_NAME's.
sudoers_text() {
    local kit_rule text apps app dir tools file
    kit_rule="$DEPLOY_USER ALL=(root) NOPASSWD:"
    kit_rule+=' /usr/local/sbin/paperroute-install-release,'
    kit_rule+=' /usr/local/sbin/paperroute-install-files ""'
    text=$(sudoers_file "$SHARE/deploy/sudoers/paperroute-deploy" \
        "$kit_rule") || exit 1
    if [[ $'\n'$text$'\n' != *$'\n'"$kit_rule"$'\n'* ]]; then
        printf 'provision-device: sudoers check failed\n' >&2
        exit 1
    fi
    printf '%s\n' "$text"
    apps=$(
        installed_apps
        [[ -z ${APP_COPY:-} ]] || printf '%s\n' "$APP_NAME"
    )
    for app in $(sort -u <<<"$apps"); do
        dir=$SHARE/apps/$app
        [[ -z ${APP_COPY:-} || $app != "$APP_NAME" ]] || dir=$APP_COPY
        tools=$(app_tool_names "$dir") || exit 1
        for file in "$dir"/sudoers/*; do
            [[ -e $file || -L $file ]] || continue
            sudoers_file "$file" "$kit_rule" "$app" "$tools" || exit 1
        done
    done
}

# Checks every app's tools and sudoers lines, so a refusal comes before
# any tool or sudoers file is installed.
check_app_part() {
    sudoers_text >/dev/null || exit 1
}

# Checks the app's staged copy and moves it to $SHARE/apps/APP_NAME; a
# refused copy is removed and the old one kept.
take_app_copy() {
    if ! (APP_COPY=$SHARE/apps/$APP_NAME.new check_app_part); then
        rm -rf -- "${SHARE:?}/apps/$APP_NAME.new"
        exit 1
    fi
    move_in "apps/$APP_NAME"
}

# Takes the install lock on fd 9 for the rest of the run.
hold_install_lock() {
    exec 9>"$LOCK"
    if ! flock -n 9; then
        printf 'provision-device: an install or a switch is running\n' >&2
        exit 1
    fi
}

# Prints the timers the single-app layout's app-timers lists, one per line.
old_timers() {
    local name
    [[ -f $SHARE/app-timers ]] || return 0
    while IFS= read -r name || [[ -n $name ]]; do
        [[ ! $name =~ $TIMER_RE ]] || printf '%s\n' "$name"
    done <"$SHARE/app-timers"
}

# Exits 1, with the old app's timers started again, while one of its
# services is running.
check_old_services() {
    local path name state timer
    for path in "$SHARE"/app/systemd/*.service; do
        [[ -f $path ]] || continue
        name=${path##*/}
        state=$(systemctl is-active "$name" || true)
        [[ $state == active || $state == activating \
            || $state == reloading ]] || continue
        for timer in $(old_timers); do
            systemctl start "$timer" || true
        done
        printf 'provision-device: %s is running; %s\n' "$name" \
            'try again when it has finished' >&2
        exit 1
    done
}

# Moves $OPT/releases to $OPT/apps/OLD/releases and points that app's
# current at the release $OPT/current names there.
move_releases() {
    local apps=$OPT/apps/$1 target
    make_dir root 0755 "$OPT/apps"
    make_dir root 0755 "$apps"
    if [[ -e $OPT/releases && ! -e $apps/releases ]]; then
        mv -T -- "$OPT/releases" "$apps/releases"
    fi
    target=$(readlink -- "$OPT/current" || true)
    if [[ $target == "$OPT/releases/"* ]]; then
        ln -sfn -- "$apps/releases/${target#"$OPT/releases/"}" "$apps/current"
    fi
}

# Moves every entry of $VAR but apps into $VAR/apps/OLD as the service
# user, never over a name already there, then names what is left.
move_data() {
    local home=$VAR/apps/$1 left name
    if ! setsid -w runuser -u paperroute -- install -d -m 0750 "$VAR/apps" \
        "$home" </dev/null >/dev/null 2>&1 9>&-; then
        printf 'provision-device: paperroute could not create %s\n' "$home" >&2
        exit 1
    fi
    if ! setsid -w runuser -u paperroute -- sh -c 'for path in "$1"/* "$1"/.[!.]* "$1"/..?*; do [ -e "$path" ] || [ -L "$path" ] || continue; [ "${path##*/}" != apps ] || continue; [ -e "$2/${path##*/}" ] || [ -L "$2/${path##*/}" ] || mv -- "$path" "$2/" || exit 1; done' sh "$VAR" "$home" \
        </dev/null >/dev/null 2>&1 9>&-; then
        printf 'provision-device: could not move %s into apps/%s; %s\n' \
            "$VAR" "$1" 'nothing was removed' >&2
        exit 1
    fi
    left=$(setsid -w runuser -u paperroute -- ls -A -- "$VAR" \
        </dev/null 2>/dev/null 9>&-) || left=
    while IFS= read -r name; do
        [[ -z $name || $name == apps ]] \
            || printf 'provision-device: left in %s: %s\n' "$VAR" "$name" >&2
    done <<<"$left"
}

# Moves a device from the single-app layout to the per-app one: its
# releases, data and record. Each step is safe to repeat; the marker
# $SHARE/adopting stays until start_board starts the board again.
adopt_single_app() {
    local old timer
    if [[ ! -e $OPT/releases && ! -e $SHARE/installed-app \
        && ! -e $SHARE/app ]]; then
        return 0
    fi
    old=$(single_app_name)
    [[ -n $old ]] || old=$(active_app)
    if [[ -z $old ]]; then
        if [[ -e $OPT/releases ]]; then
            rmdir -- "$OPT/releases" 2>/dev/null \
                || fail 'cannot tell which app is installed'
        fi
        return 0
    fi
    [[ $old == "$APP_NAME" ]] \
        || fail "this device holds $old in the old layout; provision $old first"
    for timer in $(old_timers); do
        systemctl stop "$timer"
    done
    check_old_services
    : >"$SHARE/adopting"
    systemctl stop paperroute
    printf '%s\n' "$old" >"$SHARE/active-app"
    move_releases "$old"
    move_data "$old"
    rm -rf -- "$SHARE/app" "$SHARE/app-timers"
    rm -f -- "$SHARE/installed-app"
}

# Starts the board the migration stopped once a release can run it, then
# removes the marker.
start_board() {
    [[ -e $SHARE/adopting ]] || return 0
    [[ -x $OPT/current/.venv/bin/paperroute-board ]] || return 0
    if systemctl start --no-block paperroute; then
        rm -f -- "$SHARE/adopting"
    fi
}

# Writes the sudoers file for every installed app and checks it with
# visudo.
install_sudoers() {
    local text
    text=$(sudoers_text) || exit 1
    rm -f -- "$SUDOERS_NEW"
    (umask 0337 && printf '%s\n' "$text" >"$SUDOERS_NEW")
    if ! visudo -cf "$SUDOERS_NEW"; then
        rm -f -- "$SUDOERS_NEW"
        printf 'provision-device: sudoers check failed\n' >&2
        exit 1
    fi
    mv -T -- "$SUDOERS_NEW" "$SUDOERS"
}

# Installs the kit's tools and every installed app's, runs install-files,
# then writes the sudoers file.
install_tools() {
    local name
    make_dir root 0755 "$SBIN"
    for name in $KIT_TOOLS; do
        install -m 0755 -o root -g root "$SHARE/deploy/bin/$name" \
            "$SBIN/paperroute-$name"
    done
    install_app_tools
    "$SBIN/paperroute-install-files"
    retire_pin
    install_sudoers
}

[[ $# -eq 2 ]] || fail 'usage: provision-device DIR APP'
DIR=$1
APP_NAME=$2
[[ $APP_NAME =~ $APP_RE ]] \
    || fail 'the app must be lowercase letters and digits'
case $APP_NAME in
    install | set | switch) fail 'that name is kept for the device' ;;
esac
[[ -d $DIR && ! -L $DIR ]] || fail 'DIR is not a directory'
for need in bin/install-files bin/install-release \
    bin/paperroute-led sudoers/paperroute-deploy \
    polkit/50-paperroute-power.rules polkit/51-paperroute-network.rules; do
    [[ -f $DIR/kit/$need ]] || fail "DIR has no kit/$need"
done
[[ -n ${SUDO_USER:-} ]] || fail 'run it through sudo'
DEPLOY_USER=$SUDO_USER
[[ $DEPLOY_USER =~ ^[a-z_][a-z0-9_-]*$ ]] \
    || fail 'the deploy user must be a plain lowercase name'
[[ $DEPLOY_USER != paperroute ]] \
    || fail 'the deploy user cannot be the service user'
uid=$(id -u -- "$DEPLOY_USER" 2>/dev/null) || fail 'unknown user'
[[ $uid -ne 0 ]] || fail 'the deploy user cannot be root'
bad=$(find "$DIR" ! -user "$uid" -print -quit) || fail 'cannot read DIR'
[[ -z $bad ]] || fail "DIR is not owned by $SUDO_USER"
bad=$(find "$DIR" ! -type f ! -type d -print -quit) || fail 'cannot read DIR'
[[ -z $bad ]] || fail 'DIR may hold only regular files and directories'
[[ -d $DIR/app ]] || fail 'DIR has no app/'
contract=
if [[ -f $DIR/kit/CONTRACT ]]; then
    IFS= read -r contract <"$DIR/kit/CONTRACT" || true
fi
[[ $contract =~ $CONTRACT_RE ]] \
    || fail 'kit/CONTRACT must hold a units contract number'
check_app_units
check_ready
[[ $EUID -eq 0 ]] || fail 'checks passed; provisioning needs root'
[[ ! -e $PIN_FILE || -e /var/lib/paperroute/state.json ]] || fail 'deploy M4 first so state.json holds the pin'

apt-get update
apt-get install -y rsync curl sqlite3 avahi-daemon libegl1 libgl1 polkitd \
    fontconfig-config \
    network-manager dnsmasq-base
systemctl start NetworkManager
for _ in {1..10}; do
    systemctl is-active --quiet NetworkManager && break
    sleep 1
done
systemctl is-active --quiet NetworkManager || fail 'NetworkManager is not running'

timedatectl set-timezone UTC
systemctl enable systemd-time-wait-sync

if ! id paperroute >/dev/null 2>&1; then
    useradd --system --user-group --home-dir /var/lib/paperroute \
        --no-create-home --shell /usr/sbin/nologin paperroute
fi

make_dir root 0755 "$OPT"
make_dir root 0755 "$PYTHON_DIR"
make_dir paperroute 0750 "$VAR"
make_dir "$DEPLOY_USER" 0700 /var/cache/paperroute-stage

install_uv

