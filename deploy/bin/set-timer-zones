#!/bin/bash
# Installed as /usr/local/sbin/paperroute-set-timer-zones (root).
# Usage: paperroute-set-timer-zones check APP | apply APP ZONE
# check refuses an app whose timer names its own time zone; apply moves
# each of the app's installed timers to the zone.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
umask 022

SHARE=/usr/local/share/paperroute
ETC=/etc/systemd/system
APP_RE='^[a-z][a-z0-9]*$'
ZONE_RE='^[A-Za-z]+(/[A-Za-z0-9_+-]+)*$'
TIMER_RE='^paperroute-[a-z0-9-]+\.timer$'
NAMED_ZONE_RE='^([A-Za-z_]+/[A-Za-z0-9_+/-]+|UTC)$'
USAGE='usage: set-timer-zones check APP | apply APP ZONE'
# Tests point it at a temp directory; root always uses the real one.
if [[ $EUID -ne 0 ]]; then
    SHARE=${PAPERROUTE_SHARE:-$SHARE}
fi

fail() {
    printf 'set-timer-zones: %s\n' "$1" >&2
    exit 2
}

# Prints the timers in provision's manifest for the app, each name checked.
manifest_timers() {
    local name manifest=$SHARE/apps/$APP_NAME/timers
    [[ -f $manifest ]] || fail "$manifest is missing; run scripts/provision"
    while IFS= read -r name || [[ -n $name ]]; do
        [[ $name =~ $TIMER_RE ]] || fail 'the timer manifest names a bad timer'
        printf '%s\n' "$name"
    done <"$manifest"
}

# Prints the OnCalendar= values of a timer file's [Timer] section, one per
# line; an empty assignment clears the ones before it.
calendar_of() {
    local line section= values= header='^\[(.*)\]$'
    local calendar='^OnCalendar=(.*)$'
    while IFS= read -r line || [[ -n $line ]]; do
        if [[ $line =~ $header ]]; then
            section=${BASH_REMATCH[1]}
        elif [[ $section == Timer && $line =~ $calendar ]]; then
            line=${BASH_REMATCH[1]}
            line=${line%"${line##*[![:space:]]}"}
            if [[ -z $line ]]; then
                values=
            else
                values+=$line$'\n'
            fi
        fi
    done <"$1" || return
    printf '%s' "$values"
}

# Refuses a manifest timer whose provisioned calendar already names a zone.
check_calendars() {
    local timer values value
    for timer in $TIMERS; do
        values=$(calendar_of "$SHARE/apps/$APP_NAME/systemd/$timer") \
            || fail "cannot read $timer; run scripts/provision"
        while IFS= read -r value; do
            [[ -n $value && ${value##* } =~ $NAMED_ZONE_RE ]] || continue
            printf 'set-timer-zones: %s %s %s\n' "$timer" \
                'already names a time zone;' \
                "the app's timer must leave it to the device." >&2
            exit 1
        done <<<"$values"
    done
}

# Usage: set_timer_zone TIMER ZONE
# Restates the installed timer's own calendar in the zone, in a drop-in;
# reloads when it changed or when systemd says a reload is still due, so
# a failed reload is retried. Returns non-zero at the first failed step
# (set -e is off under `if`).
set_timer_zone() {
    local timer=$1 zone=$2 conf values value tmp
    conf=$ETC/$timer.d/app-zone.conf
    values=$(calendar_of "$ETC/$timer") || return
    mkdir -p -- "${conf%/*}" || return
    tmp=$(mktemp "$conf.XXXXXX") || return
    {
        printf '[Timer]\nOnCalendar=\n'
        while IFS= read -r value; do
            [[ -z $value ]] || printf 'OnCalendar=%s %s\n' "$value" "$zone"
        done <<<"$values"
    } >"$tmp" || return
    chmod 644 "$tmp" || return
    if ! cmp -s "$tmp" "$conf"; then
        mv -f -- "$tmp" "$conf" || return
    else
        rm -f -- "$tmp"
        if [[ $(systemctl show -p NeedDaemonReload --value "$timer") == no ]]
        then
            return 0
        fi
    fi
    systemctl daemon-reload
}

# Gives every manifest timer the zone; stops at the first failure.
set_timer_zones() {
    local timer
    for timer in $TIMERS; do
        set_timer_zone "$timer" "$ZONE" || return
    done
}

case ${1:-}:$# in
    check:2 | apply:3) ;;
    *) fail "$USAGE" ;;
esac
APP_NAME=$2
[[ $APP_NAME =~ $APP_RE ]] \
    || fail 'the app must be lowercase letters and digits'
if [[ $1 == apply ]]; then
    ZONE=$3
    if [[ ! $ZONE =~ $ZONE_RE || ! -f "/usr/share/zoneinfo/$ZONE" ]]; then
        fail 'the zone must be an installed time zone'
    fi
fi
TIMERS=$(manifest_timers) || exit
if [[ $1 == check ]]; then
    check_calendars
    exit 0
fi
[[ $EUID -eq 0 ]] || fail 'applying needs root'
set_timer_zones
