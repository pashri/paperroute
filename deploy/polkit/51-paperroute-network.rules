// Installed as /etc/polkit-1/rules.d/51-paperroute-network.rules (root, 0644).
// Lets the paperroute service user scan, join and forget Wi-Fi networks
// and share the setup hotspot through nmcli; every other request falls
// through to the defaults.
polkit.addRule(function (action, subject) {
    if (subject.user != "paperroute") {
        return;
    }
    if (action.id == "org.freedesktop.NetworkManager.network-control" ||
        action.id == "org.freedesktop.NetworkManager.settings.modify.system" ||
        action.id == "org.freedesktop.NetworkManager.wifi.scan" ||
        action.id == "org.freedesktop.NetworkManager.enable-disable-wifi" ||
        action.id == "org.freedesktop.NetworkManager.wifi.share.protected") {
        return polkit.Result.YES;
    }
});
