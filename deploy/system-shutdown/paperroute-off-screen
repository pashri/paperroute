#!/bin/sh
# Installed as /usr/lib/systemd/system-shutdown/paperroute-off-screen.
# systemd runs it with the action as $1 once everything else has stopped.
# Draws the off screen on poweroff and halt; always exits 0.
case ${1:-} in
poweroff | halt)
    "${PAPERROUTE_TIMEOUT:-/usr/bin/timeout}" 20 \
        "${PAPERROUTE_PYTHON:-/opt/paperroute/current/.venv/bin/python}" \
        -m paperroute_device.screen \
        --image /usr/local/share/paperroute/deploy/screens/off.raw \
        --state /var/lib/paperroute/state.json || true
    ;;
esac
exit 0
