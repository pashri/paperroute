[Unit]
ConditionPathExists=/dev/spidev0.0
Before=paperroute.service

[Service]
Type=oneshot
User=paperroute
Group=paperroute
SupplementaryGroups=spi gpio
NoNewPrivileges=yes
TimeoutStartSec=30
ExecStart=-/usr/bin/timeout -k 5 20 /opt/paperroute/current/.venv/bin/python -m paperroute_device.screen --image /usr/local/share/paperroute/deploy/screens/on.raw --state /opt/paperroute/data/state.json

[Install]
WantedBy=multi-user.target
