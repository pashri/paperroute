[Unit]
ConditionPathExists=/dev/spidev0.0

[Service]
Type=oneshot
User=paperroute
Group=paperroute
SupplementaryGroups=spi gpio
NoNewPrivileges=yes
TimeoutStartSec=30
ExecStart=/opt/paperroute/current/.venv/bin/python -m paperroute_device.screen --image /usr/local/share/paperroute/deploy/screens/on.raw --state /var/lib/paperroute/state.json

[Install]
WantedBy=multi-user.target
