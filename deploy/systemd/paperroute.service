[Unit]
Description=paperroute
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
ConditionPathExists=/var/lib/paperroute/timetable.db

[Service]
Type=notify
NotifyAccess=main
User=paperroute
Group=paperroute
Environment=PAPERROUTE_API_KEY_FILE=/var/lib/paperroute/secrets
ExecStart=/opt/paperroute/current/.venv/bin/python -m paperroute run --display web --timetable /var/lib/paperroute/timetable.db --tiles /var/lib/paperroute/tiles.db --state /var/lib/paperroute/state.json --error-log /var/lib/paperroute/log/errors.jsonl --rebuild --power
# + runs it as root: the paperroute user can't write delay_on or delay_off
ExecStopPost=+/usr/local/bin/paperroute-led boot
Restart=always
RestartSec=5
WatchdogSec=30
TimeoutStopSec=15
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/paperroute
ProtectHome=yes
PrivateTmp=yes
SystemCallFilter=~@debug

[Install]
WantedBy=multi-user.target
