[Unit]
Description=paperroute

[Service]
Type=notify
NotifyAccess=main
User=paperroute
Group=paperroute
SupplementaryGroups=spi gpio
Environment=FONTCONFIG_FILE=/opt/paperroute/current/packages/paperroute-device/src/paperroute_device/fontconfig/fonts.conf
ExecStart=/opt/paperroute/current/.venv/bin/paperroute-board run --display web --panel --knobs --state /var/lib/paperroute/state.json --error-log /var/lib/paperroute/log/errors.jsonl --power --wifi --version-file /opt/paperroute/current/VERSION $PAPERROUTE_APP_ARGS
# The app's drop-in, paperroute.service.d/app.conf, sets PAPERROUTE_APP_ARGS
# + runs it as root: the paperroute user can't write delay_on or delay_off
ExecStopPost=+/usr/local/bin/paperroute-led boot
Restart=always
RestartSec=5
WatchdogSec=30
TimeoutStopSec=15
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/paperroute
ProtectHome=yes
PrivateTmp=yes
SystemCallFilter=~@debug

[Install]
WantedBy=multi-user.target
