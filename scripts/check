#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
files=$(git ls-files --cached --others --exclude-standard 'src/*.py' 'packages/*/src/*.py' 'scripts/*.py' ':!packages/paperroute-testkit')
uv run isort --check-only --diff src tests scripts packages
# shellcheck disable=SC2086
uv run pylint $files
uv run mypy
for tests in packages/*/tests; do
    uv run mypy --cache-dir ".mypy_cache/${tests%/tests}" "$tests"
done
# shellcheck disable=SC2086
uv run numpydoc lint $files
uv run python scripts/check_layers.py
uv run pytest --cov --cov-report=
for tests in packages/*/tests; do
    uv run pytest "$tests" --cov --cov-append --cov-report=
done
uv run coverage report --show-missing
