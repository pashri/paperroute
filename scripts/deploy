#!/usr/bin/env bash
# Usage: scripts/deploy HOST APP
# Checks the tree, stages the tracked files of HEAD for the app on the
# Pi and installs them with the passwordless install scripts, after the
# app's scripts/before-release HOST when it has one. Never prompts.
set -euo pipefail
cd "$(dirname "$0")/.."

STAGE=/var/cache/paperroute-stage
INSTALL=/usr/local/sbin/paperroute-install-release
HOOK=scripts/before-release

usage() {
    printf 'usage: scripts/deploy HOST APP\n' >&2
    exit 2
}

[[ $# -eq 2 ]] || usage
host=$1
app=$2
[[ $host =~ ^[A-Za-z0-9][A-Za-z0-9._@-]*$ ]] || usage
[[ $app =~ ^[a-z][a-z0-9]*$ ]] || usage
if [[ ! -f apps/paperroute-$app/pyproject.toml ]]; then
    printf 'deploy: no app apps/paperroute-%s\n' "$app" >&2
    exit 2
fi

scripts/check
if [[ -n $(git status --porcelain) ]]; then
    printf 'deploy: commit or stash your changes first\n' >&2
    exit 1
fi
sha=$(git rev-parse --short HEAD)
[[ $sha =~ ^[0-9a-f]{7,12}$ ]] || {
    printf 'deploy: unexpected sha\n' >&2
    exit 1
}
if ! ssh -- "$host" sudo -n -l "$INSTALL" >/dev/null 2>&1; then
    printf 'deploy: run scripts/provision first\n' >&2
    exit 1
fi
ssh -- "$host" rm -rf "$STAGE/$sha"
git ls-files -z packages "apps/paperroute-$app" pyproject.toml uv.lock deploy/CONTRACT \
    | rsync -a --from0 --files-from=- ./ "$host:$STAGE/$sha/"
if [[ -f apps/paperroute-$app/$HOOK ]]; then
    bash "apps/paperroute-$app/$HOOK" "$host" || exit
fi
status=0
ssh -- "$host" sudo -n "$INSTALL" "$sha" "$app" || status=$?
exit "$status"
