#!/usr/bin/env bash
# Usage: scripts/provision HOST [--reboot]
# Copies deploy/ to the login user's home on the Pi and runs
# provision-device there as root. sudo asks for the password once, and
# its SUDO_USER makes the login user the deploy user.
set -euo pipefail
cd "$(dirname "$0")/.."

STAGING=.paperroute-provision

usage() {
    printf 'usage: scripts/provision HOST [--reboot]\n' >&2
    exit 2
}

[[ $# -eq 1 || $# -eq 2 ]] || usage
host=$1
reboot=no
if [[ $# -eq 2 ]]; then
    [[ $2 == --reboot ]] || usage
    reboot=yes
fi
[[ $host =~ ^[A-Za-z0-9][A-Za-z0-9._@-]*$ ]] || usage

# STAGING is relative to the remote home; $HOME expands on the Pi.
rsync -a --delete deploy/ "$host:$STAGING/"
ssh -t -- "$host" \
    "sudo bash \"\$HOME/$STAGING/bin/provision-device\" \"\$HOME/$STAGING\""
if [[ $reboot == yes ]]; then
    ssh -t -- "$host" sudo systemctl reboot
fi
