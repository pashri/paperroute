#!/usr/bin/env bash
# Usage: scripts/simulate-pi-build
# Builds the tree deploy would stage the way the Pi does, with today's
# installer and with the provisioned one it replaces, and checks what
# each venv can import and run. Stage the files with git add first.
set -euo pipefail
cd "$(dirname "$0")/.."

stage=$(mktemp -d); old=$(mktemp -d)
trap 'rm -rf -- "$stage" "$old"' EXIT
git ls-files -z src packages pyproject.toml uv.lock README.md | rsync -a --from0 --files-from=- ./ "$stage/"
rsync -a "$stage/" "$old/"
UV_LINK_MODE=copy uv sync --quiet --frozen --package paperroute --no-default-groups --no-editable --project "$stage"
UV_LINK_MODE=copy uv sync --quiet --frozen --no-dev --no-editable --project "$old"
imports="import paperroute.__main__, paperroute.screen, paperroute_hardware, paperroute_device, paperroute_transit; from importlib.util import find_spec as f"
"$stage/.venv/bin/python" -c "$imports; assert not any(f(m) for m in ('osmium', 'shapely', 'pytest', 'paperroute_testkit'))"
"$old/.venv/bin/python" -c "$imports; assert not any(f(m) for m in ('pytest', 'paperroute_testkit'))"

draw=$(cat <<'EOF'
from paperroute.app_render import MapRenderer, drawing
from paperroute.asset_root import APP_ASSETS, use_app_assets
from paperroute.core.stop_view import PinTag, Row, StopView

def row(minutes):
    return Row(
        route='606', vehicle='bus', bay='stand', platform='',
        destination='Parramatta',
        countdown=str(minutes), leaves_at=f'8:0{minutes}',
        arrives_at=f'8:3{minutes}', ride_minutes=30, live=False, pill=None,
    )

use_app_assets()
view = StopView(
    origin='Hollis St', destination='Parramatta', clock='8:00',
    hero=row(3), rows=(row(6), row(9)),
    banner='Timetable times · no live data yet', empty=None, scroll=0,
    tag=PinTag(text='pin 1/1', pinned=True, auto=False),
    head_rows=(row(3), row(6), row(9)),
)
frame = drawing(view=view, maps=MapRenderer(tiles=None))()
assert 'site-packages' in str(APP_ASSETS.fonts), APP_ASSETS.fonts
assert frame.shape == (480, 800) and frame.min() == 0, frame.shape
EOF
)
device=$(cat <<'EOF'
import sysconfig
from pathlib import Path

from paperroute.asset_root import APP_ASSETS, use_app_assets
from paperroute_device.adapters.web_common import asset, asset_bytes
from paperroute_device.core.panel_views import MenuView
from paperroute_device.render.panel import draw_panel_view

use_app_assets()
packaged = Path(sysconfig.get_paths()['purelib']) / 'paperroute' / 'assets'
for found in (APP_ASSETS.fonts, APP_ASSETS.web):
    assert Path(str(found)).is_relative_to(packaged), found
view = MenuView(clock='8:00', rows=('Wi-Fi', 'Device'), cursor=0, first=0)
frame = draw_panel_view(view=view)
assert frame.shape == (480, 800) and frame.min() == 0, frame.shape
assert asset(name='settings.html')
assert asset_bytes(name='vendor/tom-select.css')
board = packaged / 'web' / 'board.css'
assert asset(name='board.css') == board.read_text(encoding='utf-8')
EOF
)
kit_web=$(cat <<'EOF'
import asyncio
import sys
import sysconfig
from http import HTTPStatus
from pathlib import Path

import numpy as np
from aiohttp.test_utils import TestClient, TestServer

from paperroute_device.adapters.web_frame import (
    SHELL_WEB,
    shell_bytes,
    shell_text,
)
from paperroute_device.adapters.web_live import LiveView
from paperroute_device.adapters.web_shell import web_app

purelib = Path(sysconfig.get_paths()['purelib'])
assert Path(str(SHELL_WEB)) == purelib / 'paperroute_device' / 'web', SHELL_WEB
for name in (
    'device.html', 'device.js', 'setup.html', 'setup.js', 'power.html',
    'live.css', 'live.html', 'live.js',
):
    assert shell_text(name=name), name
assert shell_bytes(name='fonts/public-sans.woff2')
assert not (purelib / 'paperroute' / 'assets' / 'web' / 'device.html').exists()
live = LiveView(knobs=[].append)
app = web_app(live=live, device=None)


async def main():
    client = TestClient(TestServer(app, host='127.0.0.1', port=0))
    await client.start_server()
    try:
        assert (await client.get('/')).status == HTTPStatus.OK
        css = await client.get('/live.css')
        assert await css.read() == shell_bytes(name='live.css')
        for path in ('/board.css', '/vendor/tom-select.css'):
            missing = await client.get(path)
            assert missing.status == HTTPStatus.NOT_FOUND, (path, missing.status)
        live.show(frame=np.zeros((480, 800), np.uint8))
        frame = await client.get('/frame.png')
        assert frame.status == HTTPStatus.OK, frame.status
    finally:
        await client.close()


asyncio.run(main())
loaded = [
    name for name in sys.modules
    if name.split('.')[0] in {'paperroute', 'paperroute_transit'}
]
assert not loaded, loaded
EOF
)
no_root="from paperroute_device.render.canvas import Face, font
try:
    font(Face(weight=400, px=16))
except RuntimeError as error:
    assert 'no asset root' in str(error), error
else:
    raise AssertionError('font loaded with no asset root')"
screen_only="import paperroute.screen, sys
loaded = [
    name for name in sys.modules
    if name.split('.')[0].startswith('paperroute')
    and name not in {'paperroute', 'paperroute.screen'}
    and name.split('.')[0] != 'paperroute_hardware'
]
assert not loaded, loaded"

for py in "$stage/.venv/bin/python" "$old/.venv/bin/python"; do
    code=0
    err=$("$py" -m paperroute.screen --image deploy/screens/on.raw --state /nonexistent 2>&1 >/dev/null) || code=$?
    if [[ $code -ne 1 || $err != screen:* || $err == *Traceback* ]]; then
        printf '%s: screen exited %s\n%s\n' "$py" "$code" "$err" >&2
        exit 1
    fi
    "$py" -c "$draw"
    "$py" -c "$device"
    "$py" -c "$kit_web"
    "$py" -c "$no_root"
    "$py" -c "import paperroute.build.__main__"
    "$py" -c "$screen_only"
done
